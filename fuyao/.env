# Copy this file to fuyao/.env and customize values.

# Image settings
IMAGE_NAME=isaaclab
DOCKERFILE=fuyao.Dockerfile
FUYAO_SITE=fuyao_sh_n2
STATUS_WAIT_SECONDS=600
STATUS_POLL_INTERVAL=10

# Deploy defaults
DEFAULT_IMAGE=infra-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/data-infra/fuyao:isaaclab-260404-0534
DEFAULT_PROJECT=rc-wbc
DEFAULT_SITE=fuyao_sh_n2
DEFAULT_QUEUE=rc-wbc-4090-share
DEFAULT_EXPERIMENT=qiulm/r01
DEFAULT_GPUS=1
DEFAULT_NODES=1
DEFAULT_LABEL=test
DEFAULT_VOLUME=rc-wbc
WBT_BRANCH=fast_bm_training


# Shared GPU queue slice for remote kernel.
# 1of2 = half 4090 (~12GB VRAM, proportional CPU/RAM) — enough for IsaacLab debugging.
DEFAULT_GPU_SLICE=1of1

# Optional: W&B API key used for non-interactive login in remote kernel bootstrap.
# If set, fuyao_remote_kernel.sh injects it into ephemeral deploy snapshot only.
# WANDB_API_KEY=your_wandb_api_key_here
